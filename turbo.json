{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV", "PORT", "OPEN_ROUTER_API_KEY", "OPEN_ROUTER_MODEL", "LLM_PROVIDER"],
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"]
    },
    "deploy": {
      "dependsOn": ["^build", "^test", "^lint"]
    },
    "start": {
      "dependsOn": ["^build"]
    }
  }
}
